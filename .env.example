# Local-only defaults. scripts/run.sh loads this file from the repository root.
# This is a trusted shell configuration file: never source one from an untrusted party.
AXIOM_DATA=data
AXIOM_ORIGINS=http://localhost:8015,http://127.0.0.1:8015
AXIOM_ALLOWED_HOSTS=localhost,127.0.0.1
AXIOM_SECURE_COOKIES=0
AXIOM_PUBLIC_URL=
AXIOM_WORKER=1
AXIOM_CONNECTOR_HOSTS=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
# Keep credentials only in your local environment, never in connector JSON.
# AXIOM_SECRET_CUSTOMER_ERP=replace-locally
